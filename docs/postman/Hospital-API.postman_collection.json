{
  "info": {
    "_postman_id": "df4c1ef0-6f9e-4b5e-9a8e-6d4d0e1c2a10",
    "name": "MedFlow — Hospital API",
    "description": "Готовая коллекция для REST API MedFlow.\n\nПорядок работы:\n1. Запустите приложение (demo или mysql) на http://localhost:8080.\n2. Выполните папку «00 · Авторизация»: CSRF → вход администратора → проверка сессии → обновление CSRF.\n3. Выполняйте остальные папки по порядку. Postman сам хранит cookie сессии.\n4. Переменные created* заполняются тестами из ответов; менять их вручную не нужно.\n\nДля демонстрации используется администратор admin / Admin123!. Логин и пароль можно изменить в переменных коллекции.\n\nПримечание: создание врача в папке 02 нужно выполнить до добавления расписания в папке 03. Время записи рассчитывается на ближайший понедельник через две недели, поэтому пример не конфликтует с демо-данными.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 · Авторизация",
      "description": "Получение CSRF-токена, вход, проверка текущего пользователя. Cookie сессии Postman сохраняет автоматически.",
      "item": [
        {
          "name": "CSRF-токен",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('токен присутствует', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.headerName).to.eql('X-XSRF-TOKEN');",
                  "});",
                  "pm.collectionVariables.set('csrfToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            },
            "description": "Возвращает JSON { headerName, token } и устанавливает cookie XSRF-TOKEN. Токен сохраняется в переменную csrfToken."
          }
        },
        {
          "name": "Вход администратора",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('роль ADMIN', () => pm.expect(body.role).to.eql('ADMIN'));",
                  "pm.test('сессия создана', () => pm.expect(pm.cookies.has('JSESSIONID')).to.be.true);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-XSRF-TOKEN", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Вход по логину и паролю. Требует CSRF-заголовок из предыдущего запроса."
          }
        },
        {
          "name": "Текущий пользователь",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('есть имя пользователя', () => pm.expect(pm.response.json().username).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Проверяет, что cookie сессии подхватилась. Возвращает id, username, fullName, role, doctorId."
          }
        },
        {
          "name": "CSRF-токен после входа",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('csrfToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/csrf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "csrf"]
            },
            "description": "Обновляет CSRF-токен после смены идентификатора сессии при входе. Выполните перед изменяющими запросами."
          }
        }
      ]
    },
