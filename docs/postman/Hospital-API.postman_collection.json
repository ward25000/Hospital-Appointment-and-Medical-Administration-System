  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const pad = value => String(value).padStart(2, '0');",
          "const format = date => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;",
          "",
          "// Следующий понедельник + 14 дней: гарантированно будущий рабочий день кардиолога.",
          "const booking = new Date();",
          "let addDays = (1 - booking.getDay() + 7) % 7;",
          "if (addDays === 0) { addDays = 7; }",
          "booking.setDate(booking.getDate() + addDays + 14);",
          "pm.collectionVariables.set('bookingDate', format(booking));",
          "",
          "// Текущий календарный месяц для отчёта.",
          "const now = new Date();",
          "const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);",
          "const lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);",
          "pm.collectionVariables.set('reportFrom', format(firstDay));",
          "pm.collectionVariables.set('reportTo', format(lastDay));"
        ]
      }
    }
  ],
